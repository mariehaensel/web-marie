---
import { getCollection } from 'astro:content';
const [kontakt] = await getCollection('kontakt');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-contact-row">
      {kontakt?.data.email && <a class="footer-email" href={`mailto:${kontakt.data.email}`}>{kontakt.data.email}</a>}
      {kontakt?.data.instagram && (
        <a class="footer-social" href={kontakt.data.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="3" width="18" height="18" rx="5.5"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      )}
    </div>
    <div class="footer-meta">
      <p>&copy; {year} Marie Hänsel</p>
      <ul>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>
