---
// <picture> wrapper serving the AVIF/WebP siblings that
// scripts/generate-image-variants.mjs produces at build time, falling back
// to the original file (whatever the CMS upload's own format is) for
// browsers that support neither. No CSS changes needed elsewhere -- <picture>
// is transparent to descendant selectors like ".foo img".
interface Props {
  src: string;
  alt: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { src, alt, loading = 'lazy', fetchpriority } = Astro.props;

function withExt(path: string, ext: string) {
  return path.replace(/\.[a-zA-Z0-9]+$/, `.${ext}`);
}
---
<picture>
  <source srcset={withExt(src, 'avif')} type="image/avif" />
  <source srcset={withExt(src, 'webp')} type="image/webp" />
  <img src={src} alt={alt} loading={loading} fetchpriority={fetchpriority} />
</picture>
