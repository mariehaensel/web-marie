---
import { getCollection } from 'astro:content';

const [entry] = await getCollection('vita');
---
<section class="fullscreen-section vita-section">
  <div class="vita-photo">
    <img src={entry?.data.photo} alt="Portrait von Marie Hänsel" loading="lazy" />
  </div>
  <div class="vita-text container">
    <h2 class="section-heading">Vita</h2>
    {entry?.data.excerpt && <p class="vita-body">{entry.data.excerpt}</p>}
    <a class="section-link" href="/vita">Ausführliche Vita lesen</a>
  </div>
</section>
