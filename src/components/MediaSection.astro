---
import { getCollection } from 'astro:content';

const all = await getCollection('media');
const videos = all.filter(item => item.data.category === 'video');
const buehne = all.filter(item => item.data.category === 'buehne');
const portraits = all.filter(item => item.data.category === 'portrait');
const rest = all.filter(item => !['video', 'buehne', 'portrait'].includes(item.data.category ?? ''));
---
<section class="fullscreen-section media-section">
  <div class="container">
    <h2 class="section-heading">Medien</h2>
    <div class="media-scroll">
      {videos.length > 0 && <span class="media-group-label">Mitschnitte</span>}
      {videos.map(item => (
        <a class="media-tile" href={item.data.videoUrl} target="_blank" rel="noopener">
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          <span class="media-play" aria-hidden="true">▶</span>
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </a>
      ))}
      {buehne.length > 0 && <span class="media-group-label">Bühnenfotos</span>}
      {buehne.map(item => (
        <div class="media-tile">
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </div>
      ))}
      {portraits.length > 0 && <span class="media-group-label">Portraits</span>}
      {portraits.map(item => (
        <div class="media-tile">
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </div>
      ))}
      {rest.map(item => (
        item.data.videoUrl ? (
          <a class="media-tile" href={item.data.videoUrl} target="_blank" rel="noopener">
            <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
            <span class="media-play" aria-hidden="true">▶</span>
            {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          </a>
        ) : (
          <div class="media-tile">
            <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
            {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          </div>
        )
      ))}
    </div>
    <a class="section-link" href="/media">Alle Medien ansehen →</a>
  </div>
</section>
