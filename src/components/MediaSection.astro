---
import { getCollection } from 'astro:content';

const all = await getCollection('media');
const videos = all.filter(item => item.data.category === 'video');
const buehne = all.filter(item => item.data.category === 'buehne');
const portraits = all.filter(item => item.data.category === 'portrait');
const rest = all.filter(item => !['video', 'buehne', 'portrait'].includes(item.data.category ?? ''));
---
<section class="fullscreen-section media-section">
  <div class="container">
    <h2 class="section-heading">Medien</h2>
    <div class="media-scroll-wrap">
      <button type="button" class="media-nav media-nav-prev" aria-label="Zurück" data-media-prev>‹</button>
      <button type="button" class="media-nav media-nav-next" aria-label="Weiter" data-media-next>›</button>
      <div class="media-scroll" data-media-scroll>
      {videos.length > 0 && <span class="media-group-label">Mitschnitte</span>}
      {videos.map(item => (
        <a class="media-tile" href={item.data.videoUrl} target="_blank" rel="noopener">
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          <span class="media-play" aria-hidden="true">▶</span>
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </a>
      ))}
      {buehne.length > 0 && <span class="media-group-label">Bühnenfotos</span>}
      {buehne.map(item => (
        <button type="button" class="media-tile" data-lightbox={item.data.image} data-lightbox-caption={item.data.caption ?? item.data.title}>
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </button>
      ))}
      {portraits.length > 0 && <span class="media-group-label">Portraits</span>}
      {portraits.map(item => (
        <button type="button" class="media-tile" data-lightbox={item.data.image} data-lightbox-caption={item.data.caption ?? item.data.title}>
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          {item.data.credit && <span class="media-credit">Foto: {item.data.credit}</span>}
        </button>
      ))}
      {rest.map(item => (
        item.data.videoUrl ? (
          <a class="media-tile" href={item.data.videoUrl} target="_blank" rel="noopener">
            <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
            <span class="media-play" aria-hidden="true">▶</span>
            {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          </a>
        ) : (
          <button type="button" class="media-tile" data-lightbox={item.data.image} data-lightbox-caption={item.data.caption ?? item.data.title}>
            <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
            {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
          </button>
        )
      ))}
      </div>
    </div>
    <div class="media-progress" aria-hidden="true"><span data-media-progress></span></div>
    <a class="section-link" href="/media">Alle Medien ansehen</a>
  </div>
</section>

<script>
  document.querySelectorAll('[data-media-scroll]').forEach((scroll) => {
    if (!(scroll instanceof HTMLElement)) return;
    const wrap = scroll.closest('.media-scroll-wrap');
    const prev = wrap?.querySelector('[data-media-prev]');
    const next = wrap?.querySelector('[data-media-next]');
    const progress = wrap?.parentElement?.querySelector('[data-media-progress]');
    const scrollByAmount = (dir: number) => scroll.scrollBy({ left: dir * scroll.clientWidth * 0.8, behavior: 'smooth' });
    prev?.addEventListener('click', () => scrollByAmount(-1));
    next?.addEventListener('click', () => scrollByAmount(1));
    const updateProgress = () => {
      const max = scroll.scrollWidth - scroll.clientWidth;
      const pct = max > 0 ? (scroll.scrollLeft / max) * 100 : 0;
      if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${Math.min(100, Math.max(0, pct)) / 100})`;
    };
    scroll.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  });
</script>
