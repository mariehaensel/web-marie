---
import Layout from '../layouts/Layout.astro';
import AgendaArchiveRow from '../components/AgendaArchiveRow.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('agenda');
const today = new Date(new Date().toDateString());
const currentYear = today.getFullYear();

const upcoming = all
  .filter(e => e.data.date >= today)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const past = all
  .filter(e => e.data.date < today)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pastRecent = past.filter(e => e.data.date.getFullYear() === currentYear);

const pastByYear = new Map<number, typeof past>();
for (const entry of past) {
  const year = entry.data.date.getFullYear();
  if (year === currentYear) continue;
  if (!pastByYear.has(year)) pastByYear.set(year, []);
  pastByYear.get(year)!.push(entry);
}
const pastYears = Array.from(pastByYear.keys()).sort((a, b) => b - a);

const dayFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const yearFormatter = new Intl.DateTimeFormat('de-DE', { year: 'numeric' });

// Deutschland wechselt zwischen MEZ/MESZ, daher wird der UTC-Offset pro
// Datum über Intl aufgelöst statt fest verdrahtet (sonst wäre der Termin im
// JSON-LD im Sommer/Winter je eine Stunde daneben).
function getBerlinOffset(date: Date): string {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Europe/Berlin',
    timeZoneName: 'shortOffset',
  }).formatToParts(date);
  const tzPart = parts.find(part => part.type === 'timeZoneName')?.value ?? 'GMT+1';
  const hours = Number(tzPart.replace('GMT', '')) || 1;
  const sign = hours >= 0 ? '+' : '-';
  return `${sign}${String(Math.abs(hours)).padStart(2, '0')}:00`;
}

// "Uhrzeit" ist ein freies Textfeld im CMS (z. B. "19:30 Uhr"), keine
// validierte Eingabe -- ein nicht auswertbarer Wert darf höchstens die
// Uhrzeit im JSON-LD kosten, nie das ganze Datum.
function getEventStartDate(entry: (typeof upcoming)[number]['data']): string {
  const dateStr = entry.date.toISOString().slice(0, 10);
  const timeMatch = entry.time?.match(/(\d{1,2}):(\d{2})/);
  if (!timeMatch) return dateStr;
  const withOffset = `${dateStr}T${timeMatch[1].padStart(2, '0')}:${timeMatch[2]}:00${getBerlinOffset(entry.date)}`;
  return Number.isNaN(Date.parse(withOffset)) ? dateStr : withOffset;
}

const eventsJsonLd = upcoming.map(entry => ({
  '@context': 'https://schema.org',
  '@type': 'MusicEvent',
  name: entry.data.piece,
  startDate: getEventStartDate(entry.data),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  ...(entry.data.venue ? { location: { '@type': 'Place', name: entry.data.venue } } : {}),
  performer: { '@type': 'Person', name: 'Marie Hänsel' },
  url: entry.data.ticketLink || 'https://marie-haensel.de/agenda/',
  ...(entry.data.colleagues ? { description: entry.data.colleagues } : {}),
}));
---
<Layout title="Agenda" description="Konzert- und Opern-Termine von Marie Hänsel">
  {eventsJsonLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
  )}
  <h1 class="page-title reveal">Agenda</h1>
  {upcoming.length === 0 && <p class="agenda-empty">Aktuell sind keine Termine hinterlegt.</p>}
  <div class="agenda-list">
    {upcoming.map((entry, i) => (
      <div class="agenda-entry reveal" style={`transition-delay:${Math.min(i, 6) * 90}ms`}>
        <div class="agenda-date-block">
          <span class="agenda-day">{dayFormatter.format(entry.data.date)}</span>
          <span class="agenda-month">{monthFormatter.format(entry.data.date)} {yearFormatter.format(entry.data.date)}</span>
          {entry.data.time && <span class="agenda-time">{entry.data.time}</span>}
        </div>
        <div>
          <p class="agenda-piece">{entry.data.piece}</p>
          {entry.data.composer && <p class="agenda-composer">{entry.data.composer}</p>}
          {entry.data.colleagues && <p class="agenda-meta">{entry.data.colleagues}</p>}
          {entry.data.ensemble && <p class="agenda-meta">{entry.data.ensemble}</p>}
          {entry.data.venue && <p class="agenda-venue">{entry.data.venue}</p>}
          {entry.data.ticketLink && (
            <a class="agenda-ticket-link" href={entry.data.ticketLink} target="_blank" rel="noopener">
              {entry.data.ticketLabel || 'Weitere Infos'}
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  {past.length > 0 && (
    <div class="agenda-archive">
      <h2 class="agenda-archive-heading">Vergangene Termine</h2>

      {pastRecent.length > 0 && (
        <ul class="agenda-archive-list">
          {pastRecent.map(entry => <AgendaArchiveRow entry={entry} />)}
        </ul>
      )}

      {pastYears.map(year => (
        <details class="agenda-archive-year">
          <summary class="agenda-archive-year-summary">
            <span>{year}</span>
            <span class="agenda-archive-year-count">{pastByYear.get(year)!.length} Termine</span>
          </summary>
          <ul class="agenda-archive-list">
            {pastByYear.get(year)!.map(entry => <AgendaArchiveRow entry={entry} />)}
          </ul>
        </details>
      ))}
    </div>
  )}
</Layout>
