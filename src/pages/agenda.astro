---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const agenda = (await getCollection('agenda'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

const dayFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const yearFormatter = new Intl.DateTimeFormat('de-DE', { year: 'numeric' });
---
<Layout title="Agenda" description="Konzert- und Opern-Termine von Marie Hänsel">
  <h1 class="page-title reveal">Agenda</h1>
  {agenda.length === 0 && <p class="agenda-empty">Aktuell sind keine Termine hinterlegt.</p>}
  <div class="agenda-list">
    {agenda.map((entry, i) => (
      <div class="agenda-entry reveal" style={`transition-delay:${Math.min(i, 6) * 90}ms`}>
        <div class="agenda-date-block">
          <span class="agenda-day">{dayFormatter.format(entry.data.date)}</span>
          <span class="agenda-month">{monthFormatter.format(entry.data.date)} {yearFormatter.format(entry.data.date)}</span>
          {entry.data.time && <span class="agenda-time">{entry.data.time}</span>}
        </div>
        <div>
          <p class="agenda-piece">{entry.data.piece}</p>
          {entry.data.composer && <p class="agenda-meta">{entry.data.composer}</p>}
          {entry.data.colleagues && <p class="agenda-meta">{entry.data.colleagues}</p>}
          {entry.data.ensemble && <p class="agenda-meta">{entry.data.ensemble}</p>}
          {entry.data.venue && <p class="agenda-meta">{entry.data.venue}</p>}
          {entry.data.ticketLink && <p class="agenda-meta"><a href={entry.data.ticketLink}>Tickets →</a></p>}
        </div>
      </div>
    ))}
  </div>
</Layout>
