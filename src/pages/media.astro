---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('media');
---
<Layout title="Media" description="Audio, Video und Bildergalerie von Marie Hänsel">
  <h1 class="page-title">Media</h1>
  <div class="media-grid">
    {items.map(item => (
      item.data.videoUrl ? (
        <a class="media-tile-grid" href={item.data.videoUrl} target="_blank" rel="noopener">
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          <span class="media-play" aria-hidden="true">▶</span>
          {item.data.caption && <span class="media-caption">{item.data.caption}</span>}
        </a>
      ) : (
        <figure>
          <img src={item.data.image} alt={item.data.caption ?? item.data.title} loading="lazy" />
          {item.data.caption && <figcaption>{item.data.caption}</figcaption>}
        </figure>
      )
    ))}
  </div>
  <p style="margin-top:2rem;"><a href="https://instagram.com" target="_blank" rel="noopener">Weitere Bilder auf Instagram →</a></p>
</Layout>
