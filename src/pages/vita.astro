---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const [vitaEntry] = await getCollection('vita');
const { Content } = vitaEntry ? await render(vitaEntry) : { Content: null };
---
<Layout title="Vita">
  <div class="vita-section">
    <div class="vita-photo">
      <img src="/images/uploads/vita-portrait.jpg" alt="Portrait von Marie Hänsel" loading="lazy" />
    </div>
    <div class="vita-text">
      <h1 class="page-title">Vita</h1>
      {Content && <div class="vita-body"><Content /></div>}
    </div>
  </div>
</Layout>
