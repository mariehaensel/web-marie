---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import { getCollection } from 'astro:content';

const agenda = (await getCollection('agenda'))
  .filter(e => e.data.date >= new Date(new Date().toDateString()))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Layout title="Startseite">
  <Hero />
  <h2 class="page-title section-title">Nächste Termine</h2>
  {agenda.length === 0 && <p class="agenda-empty">Aktuell sind keine Termine hinterlegt — siehe <a href="/agenda">Agenda</a>.</p>}
  <div class="agenda-list">
    {agenda.map(entry => (
      <div class="agenda-entry">
        <div class="agenda-date">
          {dateFormatter.format(entry.data.date)}
          {entry.data.time && <span class="time">{entry.data.time}</span>}
        </div>
        <div>
          <p class="agenda-piece">{entry.data.piece}</p>
          {entry.data.venue && <p class="agenda-meta">{entry.data.venue}</p>}
        </div>
      </div>
    ))}
  </div>
  <p style="margin-top:2rem;"><a href="/agenda">Alle Termine ansehen →</a></p>
</Layout>
