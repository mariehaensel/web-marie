---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VitaSection from '../components/VitaSection.astro';
import MediaSection from '../components/MediaSection.astro';
import { getCollection } from 'astro:content';

const agenda = (await getCollection('agenda'))
  .filter(e => e.data.date >= new Date(new Date().toDateString()))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(0, 3);

const [kontakt] = await getCollection('kontakt');

const dayFormatter = new Intl.DateTimeFormat('de-DE', { day: '2-digit' });
const monthFormatter = new Intl.DateTimeFormat('de-DE', { month: 'short' });
const yearFormatter = new Intl.DateTimeFormat('de-DE', { year: 'numeric' });

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Marie Hänsel',
  jobTitle: 'Sopranistin',
  url: 'https://marie-haensel.de/',
  image: 'https://marie-haensel.de/images/uploads/hero-portrait-3.jpg',
  description: 'Sopranistin mit Schwerpunkt Oper, Konzert und Lied.',
  ...(kontakt?.data.instagram ? { sameAs: [kontakt.data.instagram] } : {}),
};
---
<Layout title="Startseite" hero={true} description="Marie Hänsel, Sopranistin — Konzerte, Opernpartien und Liederabende. Agenda, Vita, Media und Kontakt.">
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  <Hero />

  <section class="fullscreen-section home-section">
    <p class="section-watermark" aria-hidden="true">Agenda</p>
    <div class="container">
      <h2 class="section-heading">Agenda</h2>
      {agenda.length === 0 && <p class="agenda-empty">Aktuell sind keine Termine hinterlegt — siehe <a href="/agenda">Agenda</a>.</p>}
      <div class="agenda-list">
        {agenda.map((entry, i) => {
          return (
            <div class="agenda-entry reveal" style={`transition-delay:${i * 90}ms`}>
              <div class="agenda-date-block">
                <span class="agenda-day">{dayFormatter.format(entry.data.date)}</span>
                <span class="agenda-month">{monthFormatter.format(entry.data.date)} {yearFormatter.format(entry.data.date)}</span>
                {entry.data.time && <span class="agenda-time">{entry.data.time}</span>}
              </div>
              <details class="agenda-preview-details">
                <summary class="agenda-preview-summary">
                  <p class="agenda-piece">{entry.data.piece}</p>
                  {entry.data.composer && <p class="agenda-composer">{entry.data.composer}</p>}
                  {entry.data.venue && <p class="agenda-meta">{entry.data.venue}</p>}
                  <span class="agenda-preview-toggle">Details</span>
                </summary>
                <div class="agenda-preview-more">
                  {entry.data.colleagues && <p class="agenda-meta">{entry.data.colleagues}</p>}
                  {entry.data.ensemble && <p class="agenda-meta">{entry.data.ensemble}</p>}
                </div>
              </details>
            </div>
          );
        })}
      </div>
      <a class="section-link" href="/agenda">Alle Termine ansehen</a>
    </div>
  </section>

  <VitaSection />

  <MediaSection />

  <section class="fullscreen-section home-section kontakt-section kontakt-teaser">
    <div class="kontakt-bg" aria-hidden="true">
      <img src={kontakt?.data.backgroundImage} alt="" loading="lazy" />
    </div>
    <div class="kontakt-scrim" aria-hidden="true"></div>
    <h2 class="section-heading kontakt-teaser-heading">Kontakt</h2>
    <div class="kontakt-cta-row">
      <a class="kontakt-cta kontakt-cta-primary" href="/kontakt">Kontaktformular</a>
      {kontakt?.data.email && <a class="kontakt-cta" href={`mailto:${kontakt.data.email}`}>E-Mail</a>}
      {kontakt?.data.instagram && <a class="kontakt-cta" href={kontakt.data.instagram} target="_blank" rel="noopener">Instagram</a>}
    </div>
  </section>
</Layout>
