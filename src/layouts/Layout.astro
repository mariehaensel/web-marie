---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '@fontsource/urbanist/200.css';
import '@fontsource/urbanist/200-italic.css';
import '@fontsource/urbanist/500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hero?: boolean;
}

const { title, description = 'Marie Hänsel – Sopran', hero = false } = Astro.props;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · Marie Hänsel</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class={`site-header ${hero ? 'header-overlay' : ''}`} id="site-header">
    <div class="site-header-inner">
      <div class="site-brand">
        <p class="site-title"><a href="/">Marie Hänsel</a></p>
        <p class="site-subtitle-header"><em>Sopran</em></p>
      </div>
    </div>
  </header>
  <Nav hero={hero} />
  <main>
    <div class="container">
      <slot />
    </div>
  </main>
  <Footer />
  <dialog id="lightbox" class="lightbox">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" aria-label="Schließen">✕</button>
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
  </dialog>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduceMotion) {
        els.forEach(el => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => io.observe(el));
      }

      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCaption = document.getElementById('lightbox-caption');
      if (lightbox && lightboxImg && lightboxCaption) {
        document.addEventListener('click', (e) => {
          const trigger = e.target.closest('[data-lightbox]');
          if (!trigger) return;
          const caption = trigger.getAttribute('data-lightbox-caption') || '';
          lightboxImg.src = trigger.getAttribute('data-lightbox');
          lightboxImg.alt = caption;
          lightboxCaption.textContent = caption;
          lightbox.showModal();
        });
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox || e.target.closest('.lightbox-close')) {
            lightbox.close();
          }
        });
      }

      const header = document.getElementById('site-header');
      const toggle = document.getElementById('nav-toggle');
      // Sections with a dark/photo background need the light "overlay" header
      // (white text). Everything else gets the "scrolled" dark-ink header.
      // Re-evaluated per section instead of a one-way hero->scrolled switch,
      // so the header stays legible over every dark section, not just the Hero.
      const darkSections = document.querySelectorAll('.hero-section, .media-section, .kontakt-section');
      if (header && header.classList.contains('header-overlay') && darkSections.length) {
        const setScrolled = (isScrolled) => {
          header.classList.toggle('scrolled', isScrolled);
          toggle?.classList.toggle('scrolled', isScrolled);
        };
        if (!('IntersectionObserver' in window)) {
          setScrolled(true);
        } else {
          const themeObs = new IntersectionObserver((entries) => {
            entries.forEach(e => {
              e.target.dataset.headerActive = e.isIntersecting ? '1' : '0';
            });
            const anyDarkActive = Array.from(darkSections).some(s => s.dataset.headerActive === '1');
            setScrolled(!anyDarkActive);
          }, { threshold: 0.5 });
          darkSections.forEach(s => themeObs.observe(s));
        }
      }
    });
  </script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
