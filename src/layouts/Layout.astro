---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  hero?: boolean;
}

const { title, description = 'Marie Hänsel – Sopran', hero = false } = Astro.props;
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} · Marie Hänsel</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <header class={`site-header ${hero ? 'header-overlay' : ''}`} id="site-header">
    <div class="container site-header-inner">
      <p class="site-title"><a href="/">Marie Hänsel</a></p>
      <Nav />
    </div>
  </header>
  <main>
    <div class="container">
      <slot />
    </div>
  </main>
  <Footer />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" is:inline></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const els = document.querySelectorAll('.reveal');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduceMotion) {
        els.forEach(el => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.15 });
        els.forEach(el => io.observe(el));
      }

      const header = document.getElementById('site-header');
      const sentinel = document.querySelector('.hero-sentinel');
      if (header && header.classList.contains('header-overlay') && sentinel) {
        if (!('IntersectionObserver' in window)) {
          header.classList.add('scrolled');
        } else {
          const headerObs = new IntersectionObserver((entries) => {
            entries.forEach(e => header.classList.toggle('scrolled', !e.isIntersecting));
          }, { rootMargin: '-80px 0px 0px 0px', threshold: 0 });
          headerObs.observe(sentinel);
        }
      }
    });
  </script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
    }
  </script>
</body>
</html>
